{"nodes": [{"id": "business_model_overview", "label": "FreeCertify Business Model", "file_type": "document", "source_file": "BUSINESS_MODEL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "business_model_freemium", "label": "Freemium Pro Subscription", "file_type": "rationale", "source_file": "BUSINESS_MODEL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Free tier must stay genuinely valuable to scale ad revenue and democratize access; a single $6.99/mo Pro tier with a no-credit-card 7-day trial avoids decision paralysis and converts better than discounts since users form habits around Pro features."}, {"id": "business_model_advertising", "label": "Advertising Revenue Stream", "file_type": "concept", "source_file": "BUSINESS_MODEL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Tech-educated mobile users command premium CPM ($8-18), so ads shown only to free users between lessons (never between questions) scale revenue linearly with the user base without harming learning."}, {"id": "business_model_affiliate", "label": "Certification Affiliate Commissions", "file_type": "concept", "source_file": "BUSINESS_MODEL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Highest-intent stream: users who score 75%+ on a mock exam are shown affiliate voucher links (AWS, PearsonVUE, Prometric, Udemy, Coursera) at the moment of peak purchase intent."}, {"id": "business_model_b2b", "label": "B2B Teams License", "file_type": "concept", "source_file": "BUSINESS_MODEL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Highest revenue ceiling and leverage point: one mid-size company deal equals 300+ individual Pro subscribers; deferred to Phase 3 due to long sales cycles."}, {"id": "business_model_certificates", "label": "Verified Digital Certificates", "file_type": "concept", "source_file": "BUSINESS_MODEL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "LinkedIn-visible, Credly/OpenBadges-verified credentials monetize completed effort ($9.99) and drive organic growth via certificate sharing."}, {"id": "business_model_streaks_ltv", "label": "Streak Mechanics Drive LTV", "file_type": "rationale", "source_file": "BUSINESS_MODEL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Users with 30+ day streaks have 6x lower churn, 3x higher Pro conversion, and 8x higher referral likelihood, so every feature should protect and extend streaks (Duolingo strategy)."}], "edges": [{"source": "business_model_overview", "target": "business_model_freemium", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "BUSINESS_MODEL.md", "source_location": null, "weight": 1.0}, {"source": "business_model_overview", "target": "business_model_advertising", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "BUSINESS_MODEL.md", "source_location": null, "weight": 1.0}, {"source": "business_model_overview", "target": "business_model_affiliate", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "BUSINESS_MODEL.md", "source_location": null, "weight": 1.0}, {"source": "business_model_overview", "target": "business_model_b2b", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "BUSINESS_MODEL.md", "source_location": null, "weight": 1.0}, {"source": "business_model_overview", "target": "business_model_certificates", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "BUSINESS_MODEL