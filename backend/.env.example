# Backend Environment Variables
# Copy this file to .env and fill in your values

# Django Settings
DJANGO_SECRET_KEY=your-secret-key-here
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database (for local dev, SQLite is used by default)
# DATABASE_URL=postgresql://user:password@localhost:5432/aws_exam_db

# OpenAI API (optional - for question generation)
OPENAI_API_KEY=sk-your-openai-api-key

# Manus API (optional)
MANUS_API_KEY=your-manus-api-key

# DeepSeek API (optional - AI assistant provider #1)
DEEPSEEK_API_KEY=your-deepseek-api-key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# Groq API (optional fallback - AI assistant provider #2)
GROQ_API_KEY=your-groq-api-key
GROQ_BASE_URL=https://api.groq.com/openai
GROQ_MODEL=llama-3.1-8b-instant

# CORS - Frontend URL
FRONTEND_URL=http://localhost:5173

# GitHub OAuth (mobile app — callback freecertify://)
GITHUB_CLIENT_ID=your-github-oauth-app-client-id
GITHUB_CLIENT_SECRET=your-github-oauth-app-client-secret

# Firebase Admin — required for mobile GitHub sign-in (custom tokens)
# Download from Firebase Console → Project settings → Service accounts → Generate new private key
FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-service-account.json
# Or inline JSON for production hosts (Render, etc.):
# FIREBASE_SERVICE_ACCOUNT_JSON=
